# --- Telegram ---
# Токен бота, получить у @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# --- hh.ru API ---
# User-Agent обязателен по требованиям hh.ru: "<app>/<version> (<email>)"
HH_USER_AGENT=hh-parser-bot/1.0 (you@example.com)
HH_API_BASE=https://api.hh.ru
# Минимальный интервал между запросами к API, сек (rate limit)
HH_MIN_REQUEST_INTERVAL=0.5
HH_MAX_RETRIES=5
HH_PER_PAGE=50

# --- База данных ---
# SQLite по умолчанию; для PostgreSQL: postgresql+asyncpg://user:pass@host:5432/db
# (для PostgreSQL нужен драйвер: pip install -r requirements-postgres.txt)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# --- Планировщик ---
POLL_INTERVAL_MINUTES=15
# Сколько вакансий отправить при первой проверке новой подписки
FIRST_RUN_LIMIT=5

# --- Бизнес-настройки ---
# Валюта, в которую нормализуются зарплаты (RUR/USD/EUR/KZT/BYN/UAH...)
BASE_CURRENCY=RUR
MAX_SUBSCRIPTIONS_PER_USER=10
CURRENCY_CACHE_HOURS=24

# --- Логирование ---
LOG_LEVEL=INFO
LOG_FILE=./data/logs/bot.log
